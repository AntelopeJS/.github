{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Shared dependency update policy for AntelopeJS repositories',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'schedule:daily',
  ],
  timezone: 'Europe/Brussels',
  dependencyDashboard: { enabled: false },
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],
  rebaseWhen: 'conflicted',
  ignorePaths: ['**/node_modules/**', '**/bower_components/**', '**/vendor/**', '**/examples/**', '**/__tests__/**', '**/tests/**', '**/__fixtures__/**', 'workflow-templates/**'],
  customManagers: [
    {
      customType: 'regex',
      description: 'AntelopeJS module versions in project configurations and test stacks',
      managerFilePatterns: [
        '/(^|/)antelope\\.config\\.ts$/',
        '/(^|/)antelope\\.test\\.ts$/',
        '/(^|/)src/test/antelope-modules\\.ts$/',
      ],
      matchStrings: ['package:\\s*["\'](?<depName>@antelopejs/[^"\']+)["\'],\\s*version:\\s*["\'](?<currentValue>[^"\']+)["\']'],
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      description: 'AntelopeJS module versions in a test stack kept as JSON',
      managerFilePatterns: ['/(^|/)src/test/stack-modules\\.json$/'],
      matchStrings: ['"(?<depName>@antelopejs/[^"]+)":\\s*"(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      description: 'Callers keep AntelopeJS/.github at the moving v2 tag, so Renovate never pins it to a digest',
      matchPackageNames: ['AntelopeJS/.github'],
      pinDigests: false,
      enabled: false,
    },
    {
      description: "template-dms-adonis's demo/src, demo/content and demo/frontend-vue are copies of template-dms-demo that template-demo-sync.yml keeps in step, so Renovate updates them there and never here; demo/package.json is the template's own",
      matchRepositories: ['AntelopeJS/template-dms-adonis'],
      matchFileNames: ['demo/src/**', 'demo/content/**', 'demo/frontend-vue/**'],
      enabled: false,
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['pin', 'pinDigest', 'digest', 'patch', 'minor'],
      groupName: 'GitHub Actions',
    },
    {
      description: "The interface resolver couples core, every module and the interfaces they declare, and a project's test stack runs the same modules, so every AntelopeJS package moves in one pull request, majors included, and CI records their locks once",
      matchPackageNames: ['@antelopejs/**'],
      groupName: 'AntelopeJS packages',
      separateMajorMinor: false,
    },
    {
      // The npm package and docs action share a release tag; keep them together.
      // The pack pins oxfmt and oxlint as peers and runs on @oxlint/plugins, so they move with it.
      matchPackageNames: ['@antelopejs/tooling-configs', 'AntelopeJS/tooling-configs', 'oxfmt', 'oxlint', '@oxlint/plugins'],
      groupName: 'AntelopeJS tooling configs',
      separateMajorMinor: false,
    },
    {
      description: '@types/node follows the Node.js major each package runs on, so it never moves to another major; a lockfile-only update rewrites every workspace importer to one version, so the range is bumped in the package that declares it instead',
      matchPackageNames: ['@types/node'],
      rangeStrategy: 'bump',
    },
    {
      matchPackageNames: ['@types/node'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      description: "Every update merges on green. GitHub's auto-merge puts a green pull request in the merge queue; these repositories have no merge queue, so a person merges there",
      matchRepositories: ['!AntelopeJS/cloud', '!AntelopeJS/k8s-gitops-infra', '!AntelopeJS/antelope-hardening', '!AntelopeJS/antelope-compliance'],
      automerge: true,
    },
    {
      description: 'A third-party release waits three days before it can auto-merge, so a compromised version is found and pulled first; a pin or a digest has no release date, so it does not wait',
      matchUpdateTypes: ['patch', 'minor', 'major'],
      matchPackageNames: ['!@antelopejs/**', '!AntelopeJS/**'],
      minimumReleaseAge: '3 days',
    },
    {
      description: "harbor.antelopejs.cloud answers 401 to anonymous registry calls and its dockerhub-proxy project only caches Docker Hub, so Renovate looks these images up on Docker Hub while the files keep the proxy path",
      matchDatasources: ['docker'],
      matchPackageNames: ['harbor.antelopejs.cloud/dockerhub-proxy/**'],
      overridePackageName: '{{{replace "^harbor\\.antelopejs\\.cloud/dockerhub-proxy/" "" packageName}}}',
    },
    {
      description: 'ignorePaths leaves out **/test/** of config:recommended so the custom managers read the test stacks; every other manager still skips it',
      matchFileNames: ['**/test/**'],
      matchManagers: ['!custom.regex'],
      enabled: false,
    },
  ],
}
