{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Shared dependency update policy for AntelopeJS repositories',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'schedule:weekly',
  ],
  timezone: 'Europe/Brussels',
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],
  packageRules: [
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['pin', 'pinDigest', 'digest', 'patch', 'minor'],
      groupName: 'GitHub Actions',
    },
    {
      // The npm package and docs action share a release tag; keep them together.
      // The pack pins oxfmt and oxlint as peers and runs on @oxlint/plugins, so they move with it.
      matchPackageNames: ['@antelopejs/tooling-configs', 'AntelopeJS/tooling-configs', 'oxfmt', 'oxlint', '@oxlint/plugins'],
      groupName: 'AntelopeJS tooling configs',
    },
  ],
}
